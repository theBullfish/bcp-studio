# Copy to .env for local overrides (optional — dev runs with zero config on SQLite).

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=*

# Postgres (leave unset to use SQLite locally)
# DATABASE_URL=postgresql://bcp:bcp@localhost:5432/bcp_studio

# Claude API for real caption generation (optional — falls back to templates)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
