# Copy to .env for local overrides (optional — dev runs zero-config on SQLite).

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=*
SITE_URL=http://127.0.0.1:8000

# Postgres (leave unset to use SQLite locally)
# DATABASE_URL=postgresql://bcp:bcp@localhost:5432/bcp_studio

# Claude API for real caption generation (optional — templates fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe — reuses the GritBox account (store + paid-video subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Media / self-hosted video (HLS output)
MEDIA_ROOT=./media
HLS_ROOT=./media/hls

# Background jobs (leave unset → tasks run synchronously in-process)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Object storage for media + HLS (leave bucket unset → local filesystem)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Production security
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=1

# Platform publishing OAuth (per provider; leave unset → mock publisher)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
