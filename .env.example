# Copy to .env for local overrides (optional — dev runs zero-config on SQLite).

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=*
SITE_URL=http://127.0.0.1:8000

# Postgres (leave unset to use SQLite locally)
# DATABASE_URL=postgresql://bcp:bcp@localhost:5432/bcp_studio

# Claude API for real caption generation (optional — templates fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe — reuses the GritBox account (store + paid-video subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Media / self-hosted video (HLS output)
MEDIA_ROOT=./media
HLS_ROOT=./media/hls
