# Copy to .env and adjust. docker-compose reads these.

# Postgres connection for the web app (Prisma)
DATABASE_URL=postgresql://bcp:bcp@localhost:5432/bcp_studio

# Worker service URL (the Next.js app calls this for AI plays + captions)
WORKER_URL=http://localhost:8800

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Claude API for real caption generation (optional — falls back to templates)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
